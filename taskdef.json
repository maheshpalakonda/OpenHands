{
  "family": "openhands-task",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::800960611458:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "openhands",
      "image": "800960611458.dkr.ecr.ap-south-1.amazonaws.com/openhands:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 3000,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048"
}
